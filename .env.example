# Copier en .env puis CHANGER toutes les valeurs « a_changer » (le fichier .env n'est jamais commité).
PROJECT_NAME=fraud-detection-rdc
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / TimescaleDB
POSTGRES_USER=nuru_admin
POSTGRES_PASSWORD=a_changer
POSTGRES_DB=fraud_detection_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (feature store) et Kafka (Redpanda)
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Back-office : signature des jetons JWT et compte administrateur créé au 1er démarrage
JWT_SECRET_KEY=a_changer_chaine_longue_et_aleatoire
JWT_ALGORITHM=HS256
BOOTSTRAP_ADMIN_EMAIL=admin@fraud-rdc.local
BOOTSTRAP_ADMIN_PASSWORD=a_changer

# Clés d'API : integration-layer -> scoring, et opérateurs -> integration-layer
SCORING_API_KEYS=dev-scoring-key
SCORING_API_KEY=dev-scoring-key
OPERATOR_API_KEYS=vodacom:dev-vodacom-key,airtel:dev-airtel-key,orange:dev-orange-key,visa:dev-visa-key

# Grafana (http://localhost:3001, utilisateur admin)
GRAFANA_ADMIN_PASSWORD=a_changer
