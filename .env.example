# Copier en .env puis CHANGER toutes les valeurs « a_changer » (le fichier .env n'est jamais commité).
PROJECT_NAME=fraud-detection-rdc
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / TimescaleDB
POSTGRES_USER=nuru_admin
POSTGRES_PASSWORD=a_changer
POSTGRES_DB=fraud_detection_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (feature store) et Kafka (Redpanda)
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Back-office : signature des jetons JWT et compte administrateur créé au 1er démarrage
JWT_SECRET_KEY=a_changer_chaine_longue_et_aleatoire
JWT_ALGORITHM=HS256
BOOTSTRAP_ADMIN_EMAIL=admin@fraud-rdc.local
BOOTSTRAP_ADMIN_PASSWORD=a_changer

# Clés d'API : integration-layer -> scoring, et opérateurs -> integration-layer
SCORING_API_KEYS=dev-scoring-key
SCORING_API_KEY=dev-scoring-key
OPERATOR_API_KEYS=vodacom:dev-vodacom-key,airtel:dev-airtel-key,orange:dev-orange-key,visa:dev-visa-key

# Grafana (http://localhost:3001, utilisateur admin)
GRAFANA_ADMIN_PASSWORD=a_changer

# --- Intégration opérateurs (docs/INTEGRATION_OPERATEURS.md) ---
# Secret HMAC par opérateur, DISTINCT de la clé d'API (signature X-Signature)
OPERATOR_HMAC_SECRETS=vodacom:a_changer,airtel:a_changer,orange:a_changer,visa:a_changer
REQUIRE_SIGNATURE=true
# IP autorisées par opérateur (vide = pas de restriction), ex. vodacom:10.10.0.0/16|10.20.0.5
OPERATOR_IP_ALLOWLIST=
# Clé de service integration-layer -> back-office (retours des opérateurs)
INTERNAL_API_KEY=a_changer
# Cadre légal : demo | operator_instance | shared_platform
DEPLOYMENT_MODE=demo
OPERATOR_ID=
# Plateforme mutualisée : pseudonymisation obligatoire (clé de 16 caractères minimum)
PSEUDONYMIZE_IDS=false
PSEUDONYMIZATION_KEY=

# --- Assistant d'enquête du back-office (RAG) -----------------------------------------
# Facultatif. Sans clé : recherche des cas similaires et des procédures + note assemblée
# sans modèle de langage. Avec clé : note rédigée par Claude, sans aucun identifiant client.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_EFFORT=medium

# --- Délai du scoring (integration-layer) ---------------------------------------------
# Au-delà, la transaction reçoit la décision de repli (VERIFY). 0.8 en production ;
# 2.0 conseillé sur un PC de développement chargé (Docker Desktop, 4 cœurs).
SCORING_TIMEOUT_S=0.8

# --- Sécurité locale ---------------------------------------------------------------------
# Générer des secrets forts : python scripts/security/generate_secrets.py
# Mot de passe Redis (obligatoire : docker compose refuse de démarrer sans)
REDIS_PASSWORD=a_changer
# Adresse d'écoute du port 80 (nginx). 127.0.0.1 = ce PC uniquement ;
# 0.0.0.0 = accessible depuis le réseau local (démo sur téléphone), à éviter sur un Wi-Fi public.
BIND_ADDR=127.0.0.1

# --- Pilote silencieux (données réelles) ----------------------------------------------------
# Opérateurs dont les décisions sont notées mais JAMAIS appliquées : réponse APPROVE, aucun SMS
# client. Ex. vodacom,airtel ou all. Vide = décisions appliquées. Voir docs/DONNEES_REELLES.md
SHADOW_MODE_OPERATORS=
